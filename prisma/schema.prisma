generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url is removed from here
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

model Slab {
  id                  Int      @id @default(autoincrement())
  certificationNumber String   @unique
  set                 String
  name                String
  number              String
  language            String
  variant             String?
  grade               String
  subgrade            String?
  year                String
  imageUrl            String? // Now optional
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
